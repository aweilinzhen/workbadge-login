<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#171a20" />
<title>JEETOO | 登录与注册</title>
<style>
  :root{
    color-scheme:dark;
    --white:#f7f8fa; --muted:rgba(235,239,245,.68);
    --line:rgba(255,255,255,.2); --panel:rgba(255,255,255,.10);
  }
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Microsoft YaHei",sans-serif}
  body{
    min-height:100svh;color:var(--white);overflow-x:hidden;
    background:
      radial-gradient(ellipse at 78% 42%,rgba(167,177,190,.55) 0,rgba(110,120,133,.25) 18%,transparent 43%),
      radial-gradient(ellipse at 20% 48%,rgba(89,100,114,.38) 0,transparent 44%),
      linear-gradient(155deg,#20242b 0%,#343a43 40%,#171a20 73%,#090b0e 100%);
  }
  body:before{
    content:"";position:fixed;inset:36% -15% 25%;pointer-events:none;opacity:.72;
    background:
      radial-gradient(ellipse at 80% 60%,rgba(7,10,14,.08),rgba(7,10,14,.72) 58%,transparent 72%),
      linear-gradient(166deg,transparent 0 42%,rgba(16,20,26,.7) 43% 53%,transparent 54%),
      linear-gradient(13deg,transparent 0 35%,rgba(8,11,15,.8) 36% 58%,transparent 59%);
    filter:blur(13px);
  }
  body:after{
    content:"";position:fixed;inset:auto -10% 0;height:34%;pointer-events:none;
    background:linear-gradient(180deg,transparent,rgba(0,0,0,.78));
  }
  .screen{position:relative;z-index:1;min-height:100svh;max-width:560px;margin:auto;padding:calc(env(safe-area-inset-top) + 14px) 26px calc(env(safe-area-inset-bottom) + 24px);display:flex;flex-direction:column}
  .status{height:28px;display:flex;align-items:center;justify-content:space-between;font-size:15px;font-weight:650;letter-spacing:.2px;color:#f6f7f8}
  .status-right{display:flex;align-items:center;gap:8px}
  .status svg{display:block}
  .language{position:absolute;right:25px;top:calc(env(safe-area-inset-top) + 52px);border:1px solid rgba(255,255,255,.2);background:rgba(20,23,29,.22);color:#fff;border-radius:999px;padding:7px 11px;font-size:12px;backdrop-filter:blur(12px)}
  .brand{margin-top:clamp(56px,10vh,100px);text-align:center;letter-spacing:-2px;font-size:clamp(42px,11vw,58px);font-weight:720;line-height:1}
  .brand-sub{margin-top:11px;text-align:center;font-size:10px;letter-spacing:3px;color:rgba(255,255,255,.48)}
  .hero{height:clamp(250px,38vh,370px);min-height:230px;display:flex;justify-content:center;align-items:center;position:relative;margin-top:10px}
  .glow{position:absolute;width:260px;height:260px;border-radius:50%;background:rgba(206,215,226,.2);filter:blur(52px);top:28%;left:50%;transform:translateX(-50%)}
  .device{
    position:relative;width:clamp(130px,34vw,178px);height:clamp(255px,39vh,340px);border-radius:26px;
    background:linear-gradient(105deg,#090c10 0%,#292f38 8%,#555d68 48%,#343a44 74%,#171b22 100%);
    border:1px solid rgba(220,228,238,.45);
    box-shadow:inset 3px 0 5px rgba(255,255,255,.16),inset -4px 0 8px rgba(0,0,0,.7),0 28px 48px rgba(0,0,0,.55);
    transform:perspective(900px) rotateY(-8deg) rotateZ(-1deg);
  }
  .device:before{content:"";position:absolute;left:10px;top:7px;bottom:7px;width:2px;border-radius:4px;background:rgba(0,0,0,.6);box-shadow:1px 0 1px rgba(255,255,255,.22)}
  .device-face{position:absolute;left:12px;top:7px;bottom:7px;width:67%;border-radius:20px 17px 17px 20px;background:linear-gradient(145deg,#363d47,#202630 62%,#171c24);box-shadow:inset 1px 1px 2px rgba(255,255,255,.16),inset -1px -1px 4px rgba(0,0,0,.6)}
  .device-face:after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(115deg,rgba(255,255,255,.08),transparent 38%,rgba(0,0,0,.14))}
  .device-controls{position:absolute;right:13px;top:26px;display:flex;flex-direction:column;align-items:center;gap:19px}
  .lens{width:32px;height:45px;border-radius:50%;background:radial-gradient(ellipse at 45% 35%,#707984 0,#252b33 42%,#0c0f14 72%);box-shadow:inset 0 1px 4px rgba(255,255,255,.3),0 2px 5px rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center}
  .lens.red:after{content:"";width:10px;height:8px;border-radius:2px;background:#bd2630;box-shadow:0 0 5px rgba(255,0,0,.4)}
  .lens.small{height:38px;width:30px}
  .device-label{position:absolute;right:51px;top:32px;writing-mode:vertical-rl;font-size:6px;letter-spacing:1px;color:rgba(0,0,0,.85);font-weight:700}
  .ground{position:absolute;bottom:5%;left:-18%;right:-18%;height:22%;border-radius:50% 50% 0 0;background:linear-gradient(180deg,rgba(73,81,91,.78),rgba(13,16,21,.98));filter:blur(12px);transform:rotate(-3deg)}
  .ground:after{content:"";position:absolute;inset:35% 0 0;background:repeating-linear-gradient(172deg,rgba(210,218,226,.12) 0 1px,transparent 1px 8px);opacity:.35}
  .copy{text-align:center;margin-top:-4px}
  .copy h1{font-size:21px;margin:0 0 7px;font-weight:650;letter-spacing:.3px}
  .copy p{font-size:13px;color:var(--muted);margin:0}
  .actions{margin-top:auto;padding-top:20px}
  .primary,.secondary{width:100%;height:55px;border-radius:17px;font-size:16px;font-weight:650;letter-spacing:.2px;cursor:pointer;transition:transform .15s,background .15s}
  .primary{border:0;background:#f7f8fa;color:#17191e;box-shadow:0 8px 24px rgba(0,0,0,.16)}
  .secondary{margin-top:10px;border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.09);color:#fff;backdrop-filter:blur(16px)}
  button:active{transform:scale(.985)}
  .or{display:flex;align-items:center;gap:14px;margin:19px 0 14px;color:rgba(255,255,255,.58);font-size:12px}
  .or:before,.or:after{content:"";height:1px;background:rgba(255,255,255,.22);flex:1}
  .socials{display:flex;justify-content:center;gap:20px}
  .social{width:48px;height:48px;border:0;border-radius:50%;background:#fff;color:#111;display:grid;place-items:center;cursor:pointer;box-shadow:0 5px 18px rgba(0,0,0,.18)}
  .social svg{width:22px;height:22px}
  .social-label{font-size:10px;text-align:center;color:rgba(255,255,255,.65);margin-top:6px}
  .social-wrap{display:flex;flex-direction:column;align-items:center}
  .consent{margin-top:20px;display:flex;flex-direction:column;gap:10px}
  .checkrow{display:flex;align-items:flex-start;gap:9px;color:rgba(245,247,250,.7);font-size:11px;line-height:1.55}
  .checkrow input{appearance:none;flex:0 0 15px;width:15px;height:15px;margin:1px 0 0;border:1px solid rgba(255,255,255,.55);border-radius:50%;background:transparent;position:relative;cursor:pointer}
  .checkrow input:checked{background:#f5f6f8;border-color:#f5f6f8}
  .checkrow input:checked:after{content:"";position:absolute;left:4px;top:1px;width:4px;height:8px;border:solid #171a20;border-width:0 1.7px 1.7px 0;transform:rotate(45deg)}
  .checkrow a{color:#fff;text-decoration:underline;text-underline-offset:2px}
  .hint{text-align:center;color:rgba(255,255,255,.48);font-size:10px;margin-top:11px}
  .auth-view{display:none;position:fixed;inset:0;z-index:5;background:linear-gradient(155deg,#242a33,#0c0e12);padding:calc(env(safe-area-inset-top) + 18px) 26px calc(env(safe-area-inset-bottom) + 24px);max-width:560px;margin:auto}
  .auth-view.active{display:flex;flex-direction:column}
  .back{align-self:flex-start;border:0;background:transparent;color:#fff;font-size:15px;padding:8px 0;cursor:pointer}
  .auth-title{font-size:28px;font-weight:700;margin:46px 0 9px}
  .auth-desc{font-size:13px;color:var(--muted);margin:0 0 30px}
  .field-label{font-size:12px;color:rgba(255,255,255,.75);margin:16px 0 8px}
  .field,.code-field,.country{height:52px;border-radius:13px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.08);color:#fff;padding:0 14px;font-size:15px;outline:none}
  .field:focus,.code-field:focus,.country:focus{border-color:rgba(255,255,255,.72)}
  .field{width:100%}
  .phone-row,.code-row{display:flex;gap:9px}
  .country{width:105px}
  .phone-row .field,.code-row .code-field{flex:1;min-width:0}
  .code-field{width:100%}
  .send{border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.1);color:#fff;border-radius:12px;padding:0 12px;white-space:nowrap;font-size:12px}
  .submit{margin-top:28px}
  .fineprint{font-size:11px;line-height:1.6;color:rgba(255,255,255,.48);margin-top:18px}
  .toast{position:fixed;z-index:10;left:50%;bottom:28px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:rgba(245,246,248,.95);color:#17191e;border-radius:12px;padding:11px 15px;font-size:12px;box-shadow:0 8px 30px rgba(0,0,0,.3);transition:.2s;max-width:calc(100% - 40px);text-align:center}
  .toast.show{opacity:1;transform:translate(-50%,0)}
  @media(min-width:700px){body{display:grid;place-items:center;padding:24px}.screen{width:min(100%,430px);min-height:min(900px,calc(100svh - 48px));border:1px solid rgba(255,255,255,.13);border-radius:30px;overflow:hidden;box-shadow:0 28px 90px rgba(0,0,0,.45)}.auth-view{position:absolute;inset:24px auto;width:min(430px,calc(100% - 48px));min-height:calc(100% - 48px);border-radius:30px;box-shadow:0 28px 90px rgba(0,0,0,.5)}}

  /* Layout refinement: keep the full login flow visible on common phone sizes */
  .screen{
    min-height:100svh;
    height:auto;
    overflow:visible;
    padding:calc(env(safe-area-inset-top) + 12px) 24px calc(env(safe-area-inset-bottom) + 18px);
  }
  .status{height:26px;font-size:14px}
  .language{top:calc(env(safe-area-inset-top) + 46px);right:23px;padding:6px 10px;font-size:11px}
  .brand{
    margin-top:clamp(38px,6.8vh,76px);
    font-size:clamp(40px,9.6vw,52px);
    letter-spacing:-1.8px;
  }
  .brand-sub{margin-top:8px;font-size:9px;letter-spacing:2.6px}
  .hero{
    height:clamp(205px,29vh,300px);
    min-height:205px;
    margin-top:4px;
    flex:0 0 auto;
  }
  .device{
    width:clamp(118px,30vw,158px);
    height:clamp(205px,28vh,275px);
    border-radius:24px;
  }
  .device-face{border-radius:19px 16px 16px 19px}
  .device-controls{right:11px;top:22px;gap:15px}
  .lens{width:29px;height:39px}
  .lens.small{width:27px;height:33px}
  .device-label{right:45px;top:28px;font-size:5.5px}
  .ground{bottom:3%;height:18%}
  .copy{margin-top:0}
  .copy h1{font-size:20px;margin-bottom:6px}
  .copy p{font-size:12px}
  .actions{padding-top:16px}
  .primary,.secondary{height:52px;border-radius:15px;font-size:15px}
  .secondary{margin-top:9px}
  .or{gap:12px;margin:15px 0 12px;font-size:11px}
  .socials{gap:18px}
  .social{width:44px;height:44px}
  .social svg{width:21px;height:21px}
  .social-label{font-size:9px;margin-top:4px}
  .consent{margin-top:14px;gap:7px}
  .checkrow{gap:8px;font-size:10px;line-height:1.45}
  .checkrow input{flex-basis:14px;width:14px;height:14px}
  .checkrow input:checked:after{left:3.5px;top:1px;width:4px;height:7px}
  .hint{font-size:9px;line-height:1.4;margin-top:7px}
  .auth-view{overflow-y:auto}
  @media(max-height:820px){
    .brand{margin-top:34px}
    .hero{height:clamp(180px,25vh,230px);min-height:180px}
    .device{height:clamp(180px,23vh,220px)}
    .actions{padding-top:12px}
    .consent{margin-top:11px}
    .or{margin:12px 0 9px}
  }
  @media(max-height:700px){
    .screen{padding-top:calc(env(safe-area-inset-top) + 8px);padding-bottom:calc(env(safe-area-inset-bottom) + 14px)}
    .brand{margin-top:24px;font-size:38px}
    .brand-sub{margin-top:6px}
    .hero{height:170px;min-height:170px}
    .device{height:165px;width:104px}
    .copy h1{font-size:18px}
    .primary,.secondary{height:46px}
    .social{width:38px;height:38px}
    .consent{margin-top:9px}
  }
  @media(min-width:700px){
    .screen{min-height:min(900px,calc(100svh - 48px));overflow-y:auto}
  }


  /* Reusable light auth pages, matching the supplied reference flow */
  .auth-flow{display:none;position:fixed;inset:0;z-index:8;background:#efefef;color:#101114;overflow-y:auto}
  .auth-flow.active{display:block}
  .auth-shell{width:100%;max-width:560px;min-height:100svh;margin:0 auto;padding:calc(env(safe-area-inset-top) + 10px) 22px calc(env(safe-area-inset-bottom) + 24px);display:flex;flex-direction:column}
  .auth-status{height:25px;display:flex;align-items:center;justify-content:space-between;padding:0 2px;font-size:12px;font-weight:650;color:#17191c}
  .auth-status-icons{display:flex;align-items:center;gap:5px}
  .auth-status-icons i{display:block;width:12px;height:8px;border-radius:2px;background:linear-gradient(90deg,#111 0 25%,transparent 25% 35%,#111 35% 60%,transparent 60% 70%,#111 70%)}
  .auth-status-icons i:nth-child(2){width:15px;height:9px;border:1.6px solid #111;border-radius:50%;border-bottom-color:transparent;transform:rotate(0deg);background:transparent}
  .auth-status-icons b{width:21px;height:10px;border:1.5px solid #111;border-radius:3px;position:relative}
  .auth-status-icons b:before{content:"";position:absolute;right:-3px;top:2px;width:2px;height:4px;background:#111;border-radius:0 2px 2px 0}
  .auth-status-icons b:after{content:"";position:absolute;inset:1.5px 7px 1.5px 1.5px;background:#111;border-radius:1px}
  .auth-page{display:none;flex:1;position:relative;padding-top:18px;min-height:calc(100svh - 60px)}
  .auth-page.active{display:flex;flex-direction:column}
  .auth-back{width:34px;height:32px;margin:0 0 22px -7px;border:0;background:transparent;color:#17191c;font-size:29px;line-height:1;cursor:pointer;text-align:left;padding:0}
  .auth-page h1{font-size:23px;line-height:1.25;font-weight:650;letter-spacing:-.3px;margin:0 0 7px;color:#111216}
  .auth-subtitle{font-size:13px;line-height:1.5;color:#92959a;margin:0 0 24px}
  .auth-subtitle strong{display:inline-block;color:#25272b;font-weight:500;margin-top:2px}
  .auth-fields{display:flex;flex-direction:column;gap:12px}
  .auth-input{width:100%;height:52px;border:1px solid transparent;border-radius:11px;background:#fff;padding:0 15px;color:#17191d;font-size:14px;outline:none;box-shadow:0 1px 1px rgba(0,0,0,.02)}
  .auth-input::placeholder{color:#a8abb0}
  .auth-input:focus{border-color:#aeb6c3;box-shadow:0 0 0 3px rgba(20,27,39,.06)}
  .password-wrap{position:relative}
  .password-wrap .auth-input{padding-right:48px}
  .password-toggle{position:absolute;right:8px;top:7px;width:36px;height:38px;border:0;background:transparent;color:#7f838a;font-size:15px;cursor:pointer}
  .text-link{border:0;background:transparent;color:#15171b;text-decoration:underline;text-underline-offset:2px;padding:0;font-size:12px;cursor:pointer}
  .forgot-link{align-self:flex-end;margin-top:-2px;color:#24262a}
  .auth-primary{width:100%;height:52px;border:0;border-radius:11px;background:#111216;color:#fff;font-size:14px;font-weight:600;cursor:pointer;margin-top:6px;transition:opacity .15s,transform .15s}
  .auth-primary:disabled{background:#bfc0c2;color:#fff;cursor:not-allowed}
  .auth-primary:not(:disabled):active{transform:scale(.99)}
  .auth-check{display:flex;align-items:flex-start;gap:8px;font-size:11px;line-height:1.5;color:#777b82;margin-top:4px}
  .auth-check input{appearance:none;flex:0 0 14px;width:14px;height:14px;border:1px solid #999da4;border-radius:50%;margin:1px 0 0;background:transparent;position:relative}
  .auth-check input:checked{background:#111216;border-color:#111216}
  .auth-check input:checked:after{content:"";position:absolute;left:4px;top:1px;width:4px;height:7px;border:solid #fff;border-width:0 1.5px 1.5px 0;transform:rotate(45deg)}
  .auth-bottom{margin-top:auto;padding-top:32px;display:flex;align-items:center;justify-content:center;gap:8px;color:#777b82;font-size:12px}
  .auth-bottom .text-link{color:#1674d1}
  .password-rules{font-size:11px;line-height:1.65;color:#96999f;margin-top:-4px}
  .password-rules ul{margin:3px 0 0;padding-left:15px}
  .auth-legal{font-size:10px;line-height:1.5;color:#888c92;margin-top:auto;padding-top:28px}
  .auth-legal a{color:#1674d1}
  .otp-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px;margin-top:3px}
  .otp-cell{width:100%;min-width:0;height:52px;border:1px solid transparent;border-radius:10px;background:#fff;text-align:center;font-size:21px;font-weight:600;color:#17191d;outline:none}
  .otp-cell:focus{border-color:#9ba5b4;box-shadow:0 0 0 2px rgba(20,27,39,.06)}
  .resend-link{align-self:flex-start;margin-top:12px;color:#858990;text-decoration:none;font-size:11px}
  .resend-link:disabled{color:#aeb1b6;cursor:default}
  .verify-submit{margin-top:18px}
  .reset-send{margin-top:5px}
  .marketing-check{margin-top:4px}
  .auth-page [hidden]{display:none!important}
  @media(min-width:700px){
    .auth-flow{display:none;place-items:center;background:rgba(12,14,18,.72);backdrop-filter:blur(8px)}
    .auth-flow.active{display:grid}
    .auth-shell{width:390px;min-height:min(820px,calc(100svh - 48px));max-height:calc(100svh - 48px);overflow-y:auto;border-radius:24px;background:#efefef;padding:18px 25px 26px;box-shadow:0 28px 90px rgba(0,0,0,.4)}
    .auth-page{min-height:700px}
  }
  @media(max-height:700px){
    .auth-shell{padding-top:calc(env(safe-area-inset-top) + 6px);padding-bottom:calc(env(safe-area-inset-bottom) + 14px)}
    .auth-page{padding-top:10px}
    .auth-back{margin-bottom:14px}
    .auth-input,.auth-primary{height:47px}
    .auth-bottom{padding-top:20px}
    .auth-page{min-height:calc(100svh - 45px)}
  }


  /* Mobile-first correction: prevent desktop modal rules and fixed heights
     from shifting the reusable email-auth screens on phones. */
  @media (max-width: 899px) {
    html, body {
      width: 100%;
      min-width: 0;
      min-height: 100%;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    body {
      display: block;
      min-height: 100dvh;
      min-height: 100svh;
      padding: 0;
    }
    .screen {
      width: 100%;
      max-width: 560px;
      min-height: 100dvh;
      min-height: 100svh;
      height: auto;
      margin: 0 auto;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
      padding-left: clamp(18px, 5.5vw, 26px);
      padding-right: clamp(18px, 5.5vw, 26px);
    }
    .auth-view {
      position: fixed;
      inset: 0;
      width: 100%;
      max-width: 560px;
      min-height: 100dvh;
      min-height: 100svh;
      height: 100dvh;
      height: 100svh;
      margin: 0 auto;
      border-radius: 0;
      box-shadow: none;
      overflow-x: hidden;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      padding-left: clamp(18px, 5.5vw, 26px);
      padding-right: clamp(18px, 5.5vw, 26px);
    }
    .auth-flow {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      height: 100svh;
      z-index: 20;
      overflow-x: hidden;
      overflow-y: auto;
      background: #efefef;
      color: #101114;
      color-scheme: light;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-y: contain;
      scrollbar-width: none;
    }
    .auth-flow::-webkit-scrollbar,
    .auth-view::-webkit-scrollbar { display: none; }
    .auth-flow.active { display: block; }
    .auth-shell {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 480px;
      min-width: 0;
      min-height: 100dvh;
      min-height: 100svh;
      height: auto;
      margin: 0 auto;
      padding:
        calc(env(safe-area-inset-top, 0px) + 8px)
        clamp(18px, 5.5vw, 24px)
        calc(env(safe-area-inset-bottom, 0px) + 22px);
      overflow: visible;
      border-radius: 0;
      box-shadow: none;
      background: #efefef;
    }
    .auth-status {
      flex: 0 0 25px;
      width: 100%;
      min-width: 0;
      height: 25px;
      padding: 0 2px;
    }
    .auth-page {
      display: none;
      flex: 1 0 auto;
      width: 100%;
      min-width: 0;
      min-height: 0;
      height: auto;
      padding-top: 14px;
      padding-bottom: 8px;
      overflow: visible;
    }
    .auth-page.active {
      display: flex;
      flex-direction: column;
    }
