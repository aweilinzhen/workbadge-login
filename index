      <h1 data-i18n="emailLoginTitle">邮箱登录</h1>
      <div class="auth-fields">
        <input id="loginEmail" class="auth-input" type="email" autocomplete="email" data-i18n-placeholder="emailPlaceholder" placeholder="邮箱地址">
        <div class="password-wrap">
          <input id="loginPassword" class="auth-input" type="password" autocomplete="current-password" data-i18n-placeholder="passwordPlaceholder" placeholder="密码">
          <button class="password-toggle" data-toggle="loginPassword" type="button" aria-label="显示密码">◉</button>
        </div>
        <button class="text-link forgot-link" id="forgotLink" type="button" data-i18n="forgotPassword">忘记密码？</button>
        <button class="auth-primary" id="loginSubmit" type="button" data-i18n="loginAction">登录</button>
        <label class="auth-check marketing-check"><input type="checkbox" id="loginMarketing"><span data-i18n="marketingOpt">通过邮件接收 JEETOO 产品资讯与优惠活动（可随时退订）。</span></label>
      </div>
      <div class="auth-bottom"><span data-i18n="noAccount">还没有账号？</span><button class="text-link" id="goSignUp" type="button" data-i18n="signUp">立即注册</button></div>
    </section>

    <section class="auth-page" data-page="signUp">
      <button class="auth-back" data-back-page="emailLogin" aria-label="Back">‹</button>
      <h1 data-i18n="createAccountTitle">创建账号</h1>
      <p class="auth-subtitle" data-i18n="createIntro">创建 JEETOO 账号，开始使用智能设备服务</p>
      <div class="auth-fields">
        <input id="signupEmail" class="auth-input" type="email" autocomplete="email" data-i18n-placeholder="emailPlaceholder" placeholder="邮箱地址">
        <div class="password-wrap">
          <input id="signupPassword" class="auth-input" type="password" autocomplete="new-password" data-i18n-placeholder="passwordPlaceholder" placeholder="密码">
          <button class="password-toggle" data-toggle="signupPassword" type="button" aria-label="显示密码">◉</button>
        </div>
        <div class="password-rules">
          <div data-i18n="passwordRules">密码要求：</div>
          <ul><li data-i18n="ruleLength">8–20 个字符</li><li data-i18n="ruleMix">同时包含大写字母、小写字母和数字</li><li data-i18n="ruleNoSpace">不能包含空格</li></ul>
        </div>
        <button class="auth-primary" id="signupContinue" type="button" data-i18n="continue">继续</button>
        <label class="auth-check"><input type="checkbox" id="signupMarketing"><span data-i18n="marketingOpt">通过邮件接收 JEETOO 产品资讯与优惠活动（可随时退订）。</span></label>
      </div>
      <p class="auth-legal" data-i18n="termsNote">继续即表示你同意《用户协议》和《隐私政策》。</p>
    </section>

    <section class="auth-page" data-page="verifyEmail">
      <button class="auth-back" id="verifyBack" aria-label="Back">‹</button>
      <h1 data-i18n="verifyEmailTitle">验证邮箱</h1>
      <p class="auth-subtitle"><span data-i18n="verifyIntro">我们已向以下邮箱发送验证码</span><br><strong id="verifyAddress"></strong></p>
      <div class="otp-grid" id="otpGrid" aria-label="6 digit verification code">
        <input class="otp-cell" inputmode="numeric" autocomplete="one-time-code" maxlength="1" aria-label="验证码第1位">
        <input class="otp-cell" inputmode="numeric" maxlength="1" aria-label="验证码第2位">
        <input class="otp-cell" inputmode="numeric" maxlength="1" aria-label="验证码第3位">
        <input class="otp-cell" inputmode="numeric" maxlength="1" aria-label="验证码第4位">
        <input class="otp-cell" inputmode="numeric" maxlength="1" aria-label="验证码第5位">
        <input class="otp-cell" inputmode="numeric" maxlength="1" aria-label="验证码第6位">
      </div>
      <button class="text-link resend-link" id="resendCode" type="button" disabled>重新发送（59s）</button>
      <button class="auth-primary verify-submit" id="verifySubmit" type="button" disabled data-i18n="verifyAction">验证并继续</button>
    </section>

    <section class="auth-page" data-page="resetPassword">
      <button class="auth-back" data-back-page="emailLogin" aria-label="Back">‹</button>
      <h1 data-i18n="resetPasswordTitle">重置密码</h1>
      <p class="auth-subtitle" data-i18n="resetIntro">输入注册邮箱，我们将向你发送验证码</p>
      <div class="auth-fields">
        <input id="resetEmail" class="auth-input" type="email" autocomplete="email" data-i18n-placeholder="emailPlaceholder" placeholder="邮箱地址">
        <button class="auth-primary reset-send" id="resetSend" type="button" data-i18n="sendEmailCode">发送邮箱验证码</button>
      </div>
    </section>
  </div>
</section>

<div class="toast" id="toast" role="status"></div>

<script>
const translations={
  zh:{
    welcome:"欢迎使用 JEETOO",subtitle:"登录账号，开启智能设备体验",phoneLogin:"手机号登录",emailLogin:"邮箱登录",other:"其他登录方式",
    terms:'我已阅读并同意 <a href="#" onclick="return false">《用户协议》</a> 和 <a href="#" onclick="return false">《隐私政策》</a>。',
    marketing:"订阅 JEETOO 产品资讯与优惠活动（可随时退订）。",
    auto:"手机号或邮箱验证成功后，已有账号直接登录，新用户自动注册",back:"返回",authDesc:"验证码登录，首次使用将自动注册",
    phoneNumber:"手机号码",emailAddress:"邮箱地址",verificationCode:"验证码",sendCode:"获取验证码",continue:"继续",
    fine:"本页面为前端交互原型，验证码发送、账号验证及第三方授权尚未连接真实服务。",
    needTerms:"请先阅读并勾选用户协议和隐私政策",phoneTitle:"手机号登录",emailTitle:"邮箱登录",
    enterPhone:"请输入手机号码",enterEmail:"请输入邮箱地址",sent:"演示模式：验证码服务尚未接入",provider:"演示模式：第三方授权服务尚未接入",needInput:"请先填写有效的手机号或邮箱",needCode:"请输入验证码",demo:"交互原型：认证接口尚未接入"
  },
  en:{
    welcome:"Welcome to JEETOO",subtitle:"Sign in to start your smart device experience",phoneLogin:"Continue with phone",emailLogin:"Continue with email",other:"Other sign-in options",
    terms:'I agree to the <a href="#" onclick="return false">Terms of Service</a> and <a href="#" onclick="return false">Privacy Policy</a>.',
    marketing:"Email me JEETOO product news and offers. Unsubscribe at any time.",
    auto:"Existing users will sign in; new users will be registered after verification",back:"Back",authDesc:"Sign in with a code. New users are registered automatically.",
    phoneNumber:"Phone number",emailAddress:"Email address",verificationCode:"Verification code",sendCode:"Send code",continue:"Continue",
    fine:"Front-end prototype only. SMS, email verification and third-party authorization are not connected to live services.",
    needTerms:"Please agree to the Terms of Service and Privacy Policy first",phoneTitle:"Phone sign-in",emailTitle:"Email sign-in",
    enterPhone:"Enter your phone number",enterEmail:"Enter your email address",sent:"Demo mode: verification service is not connected",provider:"Demo mode: third-party authorization is not connected",needInput:"Enter a valid phone number or email address",needCode:"Enter the verification code",demo:"Prototype only: authentication API is not connected"
  }
};

Object.assign(translations.zh,{
  emailLoginTitle:"邮箱登录",createAccountTitle:"创建账号",verifyEmailTitle:"验证邮箱",resetPasswordTitle:"重置密码",
  emailPlaceholder:"邮箱地址",passwordPlaceholder:"密码",loginAction:"登录",forgotPassword:"忘记密码？",
  noAccount:"还没有账号？",signUp:"立即注册",createIntro:"创建 JEETOO 账号，开始使用智能设备服务",
  passwordRules:"密码要求：",ruleLength:"8–20 个字符",ruleMix:"同时包含大写字母、小写字母和数字",ruleNoSpace:"不能包含空格",
  verifyIntro:"我们已向以下邮箱发送验证码",resendIn:"重新发送（{s}s）",resend:"重新发送",
  verifyAction:"验证并继续",resetIntro:"输入注册邮箱，我们将向你发送验证码",sendEmailCode:"发送邮箱验证码",
  marketingOpt:"通过邮件接收 JEETOO 产品资讯与优惠活动（可随时退订）。",
  termsNote:'继续即表示你同意 <a href="#" onclick="return false">《用户协议》</a> 和 <a href="#" onclick="return false">《隐私政策》</a>。',
  emailInvalid:"请输入有效的邮箱地址",passwordInvalid:"密码需为 8–20 位，并包含大写字母、小写字母和数字",
  passwordRequired:"请输入密码",loginDemo:"演示模式：登录接口尚未接入",codeSentDemo:"演示模式：验证码发送接口尚未接入",
  codeRequired:"请输入完整的 6 位验证码",verifyDemo:"演示模式：邮箱验证接口尚未接入",showPassword:"显示密码",hidePassword:"隐藏密码",
  resetVerifiedDemo:"演示模式：验证码校验接口尚未接入，后续可接入密码重置步骤"
});
Object.assign(translations.en,{
  emailLoginTitle:"Log In",createAccountTitle:"Create your account",verifyEmailTitle:"Verify your email",resetPasswordTitle:"Reset Password",
  emailPlaceholder:"Email",passwordPlaceholder:"Password",loginAction:"Log in",forgotPassword:"Forgot password?",
  noAccount:"You don't have an account yet?",signUp:"Sign Up",createIntro:"Create your JEETOO account to continue",
  passwordRules:"Password requirements:",ruleLength:"8–20 characters",ruleMix:"Include uppercase, lowercase and numbers",ruleNoSpace:"No spaces allowed",
  verifyIntro:"We've sent a code to your email",resendIn:"Resend in {s}s",resend:"Resend",
  verifyAction:"Get started",resetIntro:"Enter your email and we'll send you a code",sendEmailCode:"Email Code",
  marketingOpt:"Email me JEETOO product news and offers. Unsubscribe at any time.",
  termsNote:'By continuing, you agree to the <a href="#" onclick="return false">User Terms</a> & <a href="#" onclick="return false">Privacy Agreement</a>.',
  emailInvalid:"Enter a valid email address",passwordInvalid:"Use 8–20 characters with uppercase, lowercase and numbers",
  passwordRequired:"Enter your password",loginDemo:"Demo: sign-in service is not connected",codeSentDemo:"Demo: email code service is not connected",
  codeRequired:"Enter the complete 6-digit code",verifyDemo:"Demo: email verification service is not connected",showPassword:"Show password",hidePassword:"Hide password",
  resetVerifiedDemo:"Demo: verification API is not connected. The password reset step can be connected next."
});

let lang="zh",mode="phone";
const $=id=>document.getElementById(id);
function toast(msg){const el=$("toast");el.textContent=msg;el.classList.add("show");clearTimeout(window.__toastTimer);window.__toastTimer=setTimeout(()=>el.classList.remove("show"),2300)}
function setLanguage(next){lang=next;document.documentElement.lang=lang==="zh"?"zh-CN":"en";document.querySelectorAll("[data-i18n]").forEach(el=>{const key=el.dataset.i18n;if(translations[lang][key])el.innerHTML=translations[lang][key]});document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{const key=el.dataset.i18nPlaceholder;if(translations[lang][key])el.placeholder=translations[lang][key]});$("langBtn").textContent=lang==="zh"?"简体中文⌄":"English⌄";$("authTitle").textContent=mode==="phone"?translations[lang].phoneTitle:translations[lang].emailTitle; if($("resendCode")){if(resendSeconds>0)$("resendCode").textContent=translations[lang].resendIn.replace("{s}",resendSeconds);else $("resendCode").textContent=translations[lang].resend}}
$("langBtn").addEventListener("click",()=>setLanguage(lang==="zh"?"en":"zh"));
function openAuth(next){if(!$("terms").checked){toast(translations[lang].needTerms);return}mode=next;$("authTitle").textContent=next==="phone"?translations[lang].phoneTitle:translations[lang].emailTitle;$("phoneFields").hidden=next!=="phone";$("emailFields").hidden=next!=="email";$("auth").classList.add("active")}
$("phoneBtn").addEventListener("click",()=>openAuth("phone"));
$("emailBtn").addEventListener("click",()=>{if(!$("terms").checked){toast(translations[lang].needTerms);return}showEmailPage("emailLogin")});
$("backBtn").addEventListener("click",()=>$("auth").classList.remove("active"));
$("sendBtn").addEventListener("click",()=>toast(translations[lang].sent));

const emailFlow=$("emailAuthFlow");
let emailFlowPurpose="signup",emailFlowAddress="",resendTimer=null,resendSeconds=59;
function showEmailPage(name){
  $("auth").classList.remove("active");
  document.activeElement?.blur?.();
  emailFlow.classList.add("active");
  emailFlow.querySelectorAll(".auth-page").forEach(page=>page.classList.toggle("active",page.dataset.page===name));
  if(name==="verifyEmail") startResendTimer();
}
function closeEmailFlow(){emailFlow.classList.remove("active");if(resendTimer){clearInterval(resendTimer);resendTimer=null}}
function validEmail(value){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim())}
function passwordValid(value){return value.length>=8&&value.length<=20&&/[A-Z]/.test(value)&&/[a-z]/.test(value)&&/[0-9]/.test(value)&&!/\s/.test(value)}
function beginVerification(purpose,email){
  emailFlowPurpose=purpose;emailFlowAddress=email.trim();$("verifyAddress").textContent=emailFlowAddress;
  document.querySelectorAll(".otp-cell").forEach(cell=>cell.value="");
  $("verifySubmit").disabled=true;
  showEmailPage("verifyEmail");
}
function startResendTimer(){
  if(resendTimer)clearInterval(resendTimer);
  resendSeconds=59;
  const btn=$("resendCode");btn.disabled=true;
  const update=()=>{btn.textContent=resendSeconds>0?translations[lang].resendIn.replace("{s}",resendSeconds):translations[lang].resend;btn.disabled=resendSeconds>0};
  update();
  resendTimer=setInterval(()=>{resendSeconds--;update();if(resendSeconds<=0){clearInterval(resendTimer);resendTimer=null}},1000);
}
document.querySelectorAll("[data-back-home]").forEach(btn=>btn.addEventListener("click",closeEmailFlow));
document.querySelectorAll("[data-back-page]").forEach(btn=>btn.addEventListener("click",()=>showEmailPage(btn.dataset.backPage)));
$("goSignUp").addEventListener("click",()=>showEmailPage("signUp"));
$("forgotLink").addEventListener("click",()=>{$("resetEmail").value=$("loginEmail").value;showEmailPage("resetPassword")});
$("verifyBack").addEventListener("click",()=>showEmailPage(emailFlowPurpose==="signup"?"signUp":"resetPassword"));
document.querySelectorAll("[data-toggle]").forEach(btn=>btn.addEventListener("click",()=>{
  const input=$(btn.dataset.toggle);input.type=input.type==="password"?"text":"password";
  btn.setAttribute("aria-label",input.type==="password"?translations[lang].showPassword:translations[lang].hidePassword);
}));
$("loginSubmit").addEventListener("click",()=>{
  const email=$("loginEmail").value.trim(),password=$("loginPassword").value;
  if(!validEmail(email)){toast(translations[lang].emailInvalid);$("loginEmail").focus();return}
  if(!password){toast(translations[lang].passwordRequired);$("loginPassword").focus();return}
  toast(translations[lang].loginDemo);
});
$("signupContinue").addEventListener("click",()=>{
  const email=$("signupEmail").value.trim(),password=$("signupPassword").value;
  if(!validEmail(email)){toast(translations[lang].emailInvalid);$("signupEmail").focus();return}
  if(!passwordValid(password)){toast(translations[lang].passwordInvalid);$("signupPassword").focus();return}
  beginVerification("signup",email);toast(translations[lang].codeSentDemo);
});
$("resetSend").addEventListener("click",()=>{
  const email=$("resetEmail").value.trim();
  if(!validEmail(email)){toast(translations[lang].emailInvalid);$("resetEmail").focus();return}
  beginVerification("reset",email);toast(translations[lang].codeSentDemo);
});
$("resendCode").addEventListener("click",()=>{
  if($("resendCode").disabled)return;
  startResendTimer();toast(translations[lang].codeSentDemo);
});
const otpCells=[...document.querySelectorAll(".otp-cell")];
otpCells.forEach((cell,index)=>{
  cell.addEventListener("input",()=>{
    cell.value=cell.value.replace(/\D/g,"").slice(-1);
    if(cell.value&&index<otpCells.length-1)otpCells[index+1].focus();
    $("verifySubmit").disabled=!otpCells.every(item=>item.value.length===1);
  });
  cell.addEventListener("keydown",event=>{
    if(event.key==="Backspace"&&!cell.value&&index>0)otpCells[index-1].focus();
    if(event.key==="ArrowLeft"&&index>0)otpCells[index-1].focus();
    if(event.key==="ArrowRight"&&index<otpCells.length-1)otpCells[index+1].focus();
  });
  cell.addEventListener("paste",event=>{
    const pasted=(event.clipboardData||window.clipboardData).getData("text").replace(/\D/g,"").slice(0,6);
    if(pasted){event.preventDefault();pasted.split("").forEach((digit,i)=>{if(otpCells[i])otpCells[i].value=digit});$("verifySubmit").disabled=!otpCells.every(item=>item.value.length===1);otpCells[Math.min(pasted.length,5)].focus()}
  });
});
$("verifySubmit").addEventListener("click",()=>{
  if(!otpCells.every(item=>item.value.length===1)){toast(translations[lang].codeRequired);return}
  closeEmailFlow();
  if(emailFlowPurpose==="signup"){
    $("loginEmail").value=emailFlowAddress;
    toast(translations[lang].verifyDemo);
  }else{
    $("loginEmail").value=emailFlowAddress;
    toast(translations[lang].resetVerifiedDemo);
  }
});

$("googleBtn").addEventListener("click",()=>toast(!$("terms").checked?translations[lang].needTerms:translations[lang].provider));
$("appleBtn").addEventListener("click",()=>toast(!$("terms").checked?translations[lang].needTerms:translations[lang].provider));
$("submitBtn").addEventListener("click",()=>{
  const input=mode==="phone"?$("phoneFields").querySelector('input[type="tel"]'):$("emailFields").querySelector('input[type="email"]');
  const value=input.value.trim();
  const valid=mode==="phone"?/^[0-9\s-]{6,20}$/.test(value):/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  if(!valid){toast(translations[lang].needInput);input.focus();return}
  if(!$("auth").querySelector('.code-field').value.trim()){toast(translations[lang].needCode);return}
  toast(translations[lang].demo);
});
</script>
</body>
</html>
